project Led_Blinker is
   for Languages use ("Ada", "ASM_CPP");

   for Source_Dirs use ("src");
   for Object_Dir use "obj";

   for Main use ("led_blinker.adb");

   for Target use "arm-eabi";
   for Runtime ("ada") use "light-cortex-m4";

   package Builder is
      for Executable ("led_blinker.adb") use "led-blinker";   
      for Executable_Suffix use ".elf";   
   end Builder;

   package Compiler is
      for Default_Switches ("ada") use (
                                        "-g",
                                        "-mcpu=cortex-m4",
                                        "-mthumb",
                                        "-mfloat-abi=hard",
                                        "-mfpu=fpv4-sp-d16",
                                        "-Os",
                                        "-Wall",
                                        "-Wextra",
                                        "-Werror",
                                        "-nostdlib"
                                       );
   end Compiler;

   package Linker is
      for Switches ("Ada") use ("-T", Project'Project_Dir & "../common/linker.ld");
   end Linker;

end Led_Blinker;
